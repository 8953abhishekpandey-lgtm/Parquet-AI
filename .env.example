ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_ENABLED=true

# Local default: embedded Qdrant stores vectors under backend/storage/qdrant.
QDRANT_MODE=embedded
QDRANT_COLLECTION=parquet_semantic_metadata

# Server mode alternative:
# QDRANT_MODE=server
# QDRANT_URL=http://localhost:6333

EMBEDDING_MODEL=all-MiniLM-L6-v2
ENABLE_SPARK_SCHEMA=true
SAMPLE_ROWS=20
QUERY_ROW_LIMIT=100
ANTHROPIC_CONTEXT_MATCH_LIMIT=10
ANTHROPIC_RESULT_ROW_LIMIT=12

# Optional: set this for higher Hugging Face Hub rate limits.
# HF_TOKEN=your_hf_token_here
